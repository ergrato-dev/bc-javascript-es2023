    "check": "eslint src && prettier --check src && vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.20.0",
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "vitest": "5.1.0"
  }
}
