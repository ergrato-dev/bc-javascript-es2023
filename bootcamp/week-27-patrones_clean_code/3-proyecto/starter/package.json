{
  "name": "proyecto-refactorizacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src",
